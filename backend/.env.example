# Show-book-kar — backend environment (example, no secrets)
#
# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Start Flask with: FLASK_APP=app.py flask run --host=0.0.0.0 --port=5000

# PostgreSQL connection (URL form; the team's db.py should parse it)
DATABASE_URL=postgresql://show_book_kar:CHANGE_ME@localhost:5432/show_book_kar

# Optional explicit values
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=show_book_kar
# DB_USER=show_book_kar
# DB_PASSWORD=CHANGE_ME

# Simple JWT/session signing secret (dev only). Rotate before demo.
# SECRET_KEY=dev-only-change-me
