# ==============================================================================
# Show-book-kar — Environment Configuration Example (.env.example)
# Copy this file to .env and adjust the values for your local environment
# ==============================================================================

# Flask Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=show_book_kar
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Booking Business Rules Configuration
HOLD_DURATION_MINUTES=5
CANCELLATION_CUTOFF_HOURS=2

